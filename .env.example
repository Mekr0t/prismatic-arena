# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Every variable the boot validator (src/config/env.ts)
# requires is listed uncommented; everything commented out is optional and shows
# its built-in default. Tuning knobs for the merge and example-team heuristics
# are deliberately NOT listed — they are read straight from process.env by the
# module that owns them and are meant to be discovered there.
# ─────────────────────────────────────────────────────────────────────────────

# Riot API key — get a DEVELOPMENT key at https://developer.riotgames.com
# NOTE: development keys expire every 24h and must be regenerated manually.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Postgres
DATABASE_URL=postgres://tft:tft@localhost:5432/tft

# Redis
REDIS_URL=redis://localhost:6379

ADMIN_PASSWORD=pick-a-strong-password
ADMIN_SESSION_SECRET=paste-a-long-random-hex-string


# ── Static data loader (npm run data:load) ───────────────────────────────────
# The live set is normally auto-detected as the newest set with a published
# roster. SET_NUMBER pins it, which you want while a set is mid-rollout.
SET_NUMBER=18

# Optional: labels the current patch on the `patches` row. Skipped when unset.
#TFT_PATCH=18.1

# The loader refuses to overwrite a live set with a stub catalog (CDragon
# publishes an empty next-set placeholder weeks early). Override deliberately.
#ALLOW_EMPTY_SET=1

# Load from a local CDragon en_us.json instead of fetching — offline, or to pin
# a patch. TFT_DATA_URL overrides the default fetch URL.
#TFT_DATA_FILE=./data/en_us.json
#TFT_DATA_URL=


# ── Rate limiting (src/server/rate-limit.ts) ─────────────────────────────────
# Two layers: per-IP for fairness, global to protect the Riot key budget when
# the per-IP key is spoofed. Defaults shown; all optional.
#RL_RIOT_PER_IP=30          # Riot-backed reads per IP per window
#RL_RIOT_GLOBAL=120         # ...and across all callers
#RL_RIOT_WINDOW_S=60
#RL_LOGIN_PER_IP=5          # admin sign-in attempts per IP per window
#RL_LOGIN_GLOBAL=20
#RL_LOGIN_WINDOW_S=300


# ── Ladder crawl ─────────────────────────────────────────────────────────────
CRAWL_PLATFORM=euw1

# Crawl scope. The drain RANK-GATES candidates against this list (one
# league.byPuuid per candidate, cached for CRAWL_TIER_TTL_HOURS), so a narrow
# scope means most of the discovered frontier is skipped.
#
# Two tokens beyond the tier names, and they are what make a crawl possible at
# the START of a set — the ladder resets, so apex is empty and nearly everyone
# is unranked until placements finish:
#   all       no gate; bucket by whatever tier resolves
#   unranked  candidates with no resolved tier are in scope (bucketed 'unknown')
#
# NARROWING THE SCOPE ALSO REWRITES THE QUEUE. The gate only governs what gets
# enqueued, and BullMQ is FIFO, so a narrowed scope would otherwise leave the old
# wide-scope backlog draining in front of the work you asked for. The worker
# reconciles the match-fetch queue against this list at BOOT — out-of-scope jobs
# are dropped, in-scope failures re-offered — so a scope change takes effect on
# the next restart rather than whenever the backlog happens to clear.
CRAWL_TIERS=challenger,grandmaster,master
#CRAWL_TIER_TTL_HOURS=72
#CRAWL_MAX_PUUIDS=25                 # candidates drained per pass
#CRAWL_MATCH_IDS_PER_PUUID=15        # deeper history = more unique matches
#CRAWL_MAX_MATCH_FETCHES=300         # per pass; ~6 min on a dev key
#CRAWL_CURRENT_PATCH_ONLY=false      # crawl full recent histories, not just the live patch

# Budget guards on the rank gate. The frontier snowballs from match participants,
# so it is ~360 k accounts of which a few hundred are apex; uncapped, the drain
# spends the key proving that low-elo accounts are low-elo (measured 2026-09-02
# at 70 league calls/min against 63 match calls/min — half the budget). Apex
# players arrive from the ladder with their tier attached and cost nothing, so
# frontier exploration only needs to be a trickle.
#CRAWL_EXPLORE_UNKNOWN=25            # tier lookups per pass on unknown-tier candidates
#CRAWL_OUT_OF_SCOPE_TTL_HOURS=720    # re-check an out-of-scope tier this rarely

# match-fetch throws only when EVERY id in a batch failed — an outage or a dead
# key, never a bad batch — so the batch is worth another attempt. A retry
# re-enters the waiting list at the BACK, and an account whose batch exhausts its
# attempts on infrastructure errors is released for an early re-crawl instead of
# sitting out CRAWL_RECRAWL_HOURS for something that was never about it.
#CRAWL_MATCH_FETCH_ATTEMPTS=3
#CRAWL_MATCH_FETCH_BACKOFF_MS=60000
#CRAWL_FAILED_RETRY_MINUTES=15       # how soon a released account is re-offered

# Boards are stamped with their player's own tier at persist time, but a player
# first seen in that very match has no resolved tier yet. Each crawl pass fills
# in the ones that have since been resolved, bounded so it can never turn a pass
# into a table sweep.
#CRAWL_TIER_STAMP_LIMIT=20000


# ── Cluster stage (src/server/queue/stages/cluster.ts) ───────────────────────
# Scan/write batch sizes. Lower the scan chunk if the worker is memory
# constrained; it trades heap for round-trips.
#CLUSTER_SCAN_CHUNK=25000
#CLUSTER_WRITE_CHUNK=5000
#CLUSTER_SET=18            # restrict clustering to one set (debug)


# ── Read cache ───────────────────────────────────────────────────────────────
# TTL for the /comps pages (src/server/comps-service.ts). Keep it well under
# SCHED_PIPELINE_MIN — the derived tables only change when the pipeline runs.
#COMPS_CACHE_TTL_S=300


# ── Worker schedule (npm run worker) ─────────────────────────────────────────
SCHED_CRAWL_MIN=15

# The derived stages are a CHAIN (cluster -> rollup -> merge -> trend-tier),
# advanced on success by src/server/queue/chain.ts. Only the head is scheduled.
SCHED_PIPELINE_MIN=30
#PIPELINE_CHAIN=false      # debug: run one stage without dragging the rest along
