# Riot API key — get a DEVELOPMENT key at https://developer.riotgames.com
# NOTE: development keys expire every 24h and must be regenerated manually.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# Seed platform for Phase 1 (e.g. euw1, na1, kr)
DEFAULT_PLATFORM=euw1

TFT_PATCH=17.5
SET_NUMBER=17

# Postgres
DATABASE_URL=postgres://tft:tft@localhost:5432/tft

# Redis
REDIS_URL=redis://localhost:6379

ADMIN_PASSWORD=pick-a-strong-password
ADMIN_SESSION_SECRET=paste-a-long-random-hex-string

# Rate limiting (src/server/rate-limit.ts). Two layers: per-IP for fairness,
# global to protect the Riot key budget when the per-IP key is spoofed.
# Defaults shown; all optional.
#RL_RIOT_PER_IP=30          # Riot-backed reads per IP per window
#RL_RIOT_GLOBAL=120         # ...and across all callers
#RL_RIOT_WINDOW_S=60
#RL_LOGIN_PER_IP=5          # admin sign-in attempts per IP per window
#RL_LOGIN_GLOBAL=20
#RL_LOGIN_WINDOW_S=300

CRAWL_PLATFORM=euw1
## Crawl scope. The drain now RANK-GATES candidates against this list (one
# league.byPuuid per candidate, cached for CRAWL_TIER_TTL_HOURS), so a narrow
# scope means most of the discovered frontier is skipped. Widen this to keep
# coverage up now that out-of-scope players no longer get crawled.
#CRAWL_TIER_TTL_HOURS=72
CRAWL_TIERS=challenger,grandmaster,master   # ~3x the apex player pool
#CRAWL_MAX_PUUIDS=60
#CRAWL_MATCH_IDS_PER_PUUID=15                 # pull deeper history per player
#CRAWL_MAX_MATCH_FETCHES=300                  # per pass; ~6 min on a dev key

# Crawl scope. The drain now RANK-GATES candidates against this list (one
# league.byPuuid per candidate, cached for CRAWL_TIER_TTL_HOURS), so a narrow
# scope means most of the discovered frontier is skipped. Widen this to keep
# coverage up now that out-of-scope players no longer get crawled.
#CRAWL_TIER_TTL_HOURS=72
CRAWL_TIERS=challenger
CRAWL_MAX_PUUIDS=80
CRAWL_MATCH_IDS_PER_PUUID=20      # deeper history per player = more unique matches
CRAWL_MAX_MATCH_FETCHES=400       # per pass; ~8 min on the dev key


# Read-cache TTL for the /comps pages (src/server/comps-service.ts). Keep it well
# under SCHED_PIPELINE_MIN — the derived tables only change when the pipeline runs.
#COMPS_CACHE_TTL_S=300

# Cluster scan/write batch sizes (src/server/queue/stages/cluster.ts). Lower the
# scan chunk if the worker is memory-constrained; it trades heap for round-trips.
#CLUSTER_SCAN_CHUNK=25000
#CLUSTER_WRITE_CHUNK=5000

SCHED_CRAWL_MIN=15

# The derived stages are a CHAIN (cluster -> rollup -> merge -> trend-tier),
# advanced on success by src/server/queue/chain.ts. Only the head is scheduled.
SCHED_PIPELINE_MIN=30
#PIPELINE_CHAIN=false      # debug: run one stage without dragging the rest along

# Legacy per-stage cadences — no longer registered. SCHED_CLUSTER_MIN is still
# read as a fallback for SCHED_PIPELINE_MIN; the rest are ignored.
#SCHED_CLUSTER_MIN=30
#SCHED_ROLLUP_MIN=30
#SCHED_TREND_TIER_MIN=720


